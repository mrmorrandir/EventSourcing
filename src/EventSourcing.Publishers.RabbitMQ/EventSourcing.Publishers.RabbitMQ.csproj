<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Title>EventSourcing.Publishers.RabbitMQ</Title>
        <Description>Extend the event sourcing system with RabbitMQ.
            Events are published with the help of the RabbitMQ.Client library.
        </Description>
        <PackageReleaseNotes>Initial stable 2.0.0 release with core abstractions, runtime integration, source-generator support, projections and publisher extensibility.</PackageReleaseNotes>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <PropertyGroup>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
        <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
        <PackageReference Include="EventSourcing" Version="$(Version)" Condition="'$(_IsPacking)' == 'true'"/>
        <PackageReference Include="EventSourcing.Publishers" Version="$(Version)" Condition="'$(_IsPacking)' == 'true'"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\EventSourcing.Publishers\EventSourcing.Publishers.csproj" Condition="'$(_IsPacking)' != 'true'"/>
        <ProjectReference Include="..\EventSourcing\EventSourcing.csproj" Condition="'$(_IsPacking)' != 'true'"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="LICENSE.txt"/>
    </ItemGroup>

</Project>
